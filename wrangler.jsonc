{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miladcraft-website-preview",
  "main": "worker.py",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["python_workers"],
  "keep_vars": true,
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miladcraft-website-db",
      "database_id": "529bb88d-9f0b-4fbe-8685-75137b20e409"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "UPLOADS",
      "id": "e7ba94a190fe4437b0ea10a0564fcdf3"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
